[Desktop Entry]
Type=Application
Name=Torrent Player
Comment=Stream and download torrents
Exec=torrentplayer %U
Icon=torrentplayer
Terminal=false
Categories=AudioVideo;Video;Player;Network;FileTransfer;P2P;
