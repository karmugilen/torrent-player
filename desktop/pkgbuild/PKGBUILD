pkgname=torrentplayer
# Same versionName as the Android app (android/app/build.gradle.kts).
pkgver=$(sed -n 's/^ *versionName = "\(.*\)"$/\1/p' ../../android/app/build.gradle.kts)
pkgrel=1
pkgdesc='Stream and download torrents, with the Torrent Player engine'
arch=('x86_64' 'aarch64')
license=('MIT' 'MPL-2.0')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'qt6-wayland' 'qt6-svg' 'xdg-desktop-portal' 'ffmpeg' 'mpv')
makedepends=('gcc' 'make' 'cargo' 'pkgconf')
options=('!debug' '!lto')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/torrentplayer "$pkgdir/usr/bin/torrentplayer"
  install -Dm755 build/engine-host "$pkgdir/usr/lib/torrentplayer/engine-host"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/torrentplayer.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/torrentplayer.svg"
  install -Dm644 "$startdir/torrentplayer.desktop" "$pkgdir/usr/share/applications/torrentplayer.desktop"
}
